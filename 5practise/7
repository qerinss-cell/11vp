FUEL_PRICE = 49.5

def fuel_litr_bens(distance, liter_na_100):
    """Возвращает сколько литров бензина нужно на всю поездку."""
    return distance * (liter_na_100 / 100)

def cost(distance, liters_na_100):
    """Возвращает стоимость бензина на поездку."""
    return fuel_litr_bens(distance, liters_na_100) * FUEL_PRICE

distance = float(input("Какое расстояние (км)? "))
liters_na_100 = float(input("Сколько литров на 100 км ест машина? "))

total_liters = fuel_litr_bens(distance, liters_na_100)
total_cost = cost(distance, liters_na_100)

print("Нужно бензина:", f"{total_liters:.2f} л")
print("Стоимость:", f"{total_cost:.2f} руб.")
